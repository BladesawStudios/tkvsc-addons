game: "The Legend of Zelda: Ocarina of Time"

# Tags worked out from the game's messages. Names shared with TotK.gcf have the same ids and the same argument layout.
# Not defined, so shown as {cmd:0xe:...}: 1:2, whose purpose is unclear. It takes no arguments and is on Dampe's diary pages and a few shouted lines.
# Names marked "inferred" come from where the tag is used and what it holds; none is checked against the game's code.
# Message files are UTF-8: a str is a 16-bit byte length and UTF-8 text, and nothing is padded.

msbt:
  tags:
    - name: ruby
      description: ruby annotation rendered above the normal text
      group: 0
      type: 0
      arguments:
        - name: span
          description: number of subsequent characters to render the annotation above
          dataType: u16
        - name: value
          description: annotation text
          dataType: str
    - name: size
      description: changes the current text size
      group: 0
      type: 2
      arguments:
        - name: value
          description: relative text size in percent
          dataType: u16
    - name: color
      description: changes the current text color
      group: 0
      type: 3
      arguments:
        - name: id
          description: id of the color
          dataType: s16
    - name: pageBreak
      description: forces a new dialog page
      group: 0
      type: 4
    - name: icon
      description: renders an icon
      group: 1
      type: 4
      arguments:
        - name: type
          description: icon type; the values differ from TotK's and are not mapped yet
          dataType: u8
    - name: var1
      description: inserts a game variable (seen with counts and prices)
      group: 2
      type: 1
      arguments:
        - name: name
          dataType: str
    - name: var3
      description: inserts a game variable (seen with item and actor names)
      group: 2
      type: 3
      arguments:
        - name: name
          dataType: str
    - name: var4
      description: inserts a game variable (seen with SimpleIntForMessage)
      group: 2
      type: 4
      arguments:
        - name: name
          dataType: str
    - name: var5
      description: inserts a game variable (seen with numbers)
      group: 2
      type: 5
      arguments:
        - name: name
          dataType: str
    - name: var6
      description: inserts a game variable (seen with shop prices)
      group: 2
      type: 6
      arguments:
        - name: name
          dataType: str
    - name: var7
      description: inserts a game variable (seen with SimpleIntForMessage)
      group: 2
      type: 7
      arguments:
        - name: name
          dataType: str
    - name: var10
      description: inserts a game variable (seen with timers)
      group: 2
      type: 10
      arguments:
        - name: name
          dataType: str
    - name: var12
      description: inserts a game variable (seen with prices and counts)
      group: 2
      type: 12
      arguments:
        - name: name
          dataType: str
    - name: var15
      description: inserts a game variable (seen with Dream World battle teams)
      group: 2
      type: 15
      arguments:
        - name: name
          dataType: str
    - name: var19
      description: inserts a game variable (seen with actor names)
      group: 2
      type: 19
      arguments:
        - name: name
          dataType: str
    - name: var20
      description: inserts a game variable (seen with item names)
      group: 2
      type: 20
      arguments:
        - name: name
          dataType: str
    - name: var22
      description: inserts a game variable (seen with actor names)
      group: 2
      type: 22
      arguments:
        - name: name
          dataType: str
    - name: var23
      description: inserts a game variable (seen with actor names)
      group: 2
      type: 23
      arguments:
        - name: name
          dataType: str
    - name: var24
      description: inserts a game variable (seen with location names)
      group: 2
      type: 24
      arguments:
        - name: name
          dataType: str
    - name: animation
      description: plays a talking animation on the speaker
      group: 4
      type: 0
      arguments:
        - name: name
          description: animation name
          dataType: str
    - name: delay8
      description: delays the text rendering by 8 frames
      group: 5
      type: 0
    - name: delay15
      description: delays the text rendering by 15 frames
      group: 5
      type: 1
    - name: delay30
      description: delays the text rendering by 30 frames
      group: 5
      type: 2
    - name: wordInfo
      description: contains grammatical information about a word
      group: 201
      type: 0
      arguments:
        - name: gender
          dataType: u8
        - name: defArticle
          dataType: u8
        - name: indefArticle
          dataType: u8
        - name: number
          description: "inferred: 1 on nearly every word, 2 on words that name a pair or are always plural, such as \"oreilles\", \"Hasenohren\" and \"guantes\". TotK.gcf has this as a bool named isPlural, but 1 is on singular words here too"
          dataType: u8
    - name: defArticle
      description: definite article determined by the next word
      group: 201
      type: 1
    - name: indefArticle
      description: indefinite article determined by the next word
      group: 201
      type: 2
    - name: uppercaseNextWord
      description: transforms the first letter of the next word to uppercase
      group: 201
      type: 3
    - name: lowercaseNextWord
      description: transforms the first letter of the next word to lowercase
      group: 201
      type: 4
    - name: gender
      description: contains gender-specific strings
      group: 201
      type: 5
      arguments:
        - name: m
          dataType: str
        - name: f
          dataType: str
        - name: n
          dataType: str
    - name: textSpeed
      description: "inferred: speeds up or slows the text after it (0.1 before \"...\", 10 on a line cut off mid-word)"
      group: 1
      type: 1
      arguments:
        - name: scale
          dataType: f32
    - name: autoAdvance
      description: "inferred: at the end of a message, moves on by itself after this many frames"
      group: 1
      type: 3
      arguments:
        - name: frames
          dataType: u32
    - name: playedSongName
      description: "inferred: the name of the song just played, in \"You played ...!\""
      group: 2
      type: 17
    - name: talkEmotion
      description: "inferred: the speaker's mood from here on. The same in every language. mood 1 and 16 go with laughing, 2 and 17 anger, 3 and 18 sadness, 4 and 19 surprise, 0 and 15 neutral. flag is mostly 1 when an animation tag follows"
      group: 3
      type: 0
      arguments:
        - name: mood
          dataType: u8
        - name: flag
          dataType: u8
        - name: reserved
          dataType: u8
    - name: pluralCase
      group: 201
      type: 6
      arguments:
        - name: arg1
          dataType: str
          description: "EUfr/USfr: 0 or 1 item. EUru: numbers ending in 1, but not 11"
        - name: arg2
          dataType: str
          description: "EUfr/USfr: 2 or more items. EUru: numbers ending in 2,3,4, but not 12,13,14"
        - name: arg3
          dataType: str
          description: "EUru: numbers ending in 5,6,7,8,9,0, and 11,12,13,14"
    - name: batchimObject
      group: 201
      type: 7
      description: korean particle chosen by whether the syllable before it ends with a consonant, for an object
      arguments:
        - name: consonant
          dataType: str
        - name: vowel
          dataType: str
    - name: nounCase
      group: 201
      type: 9
      arguments:
        - name: type
          dataType: u8
    - name: gender10
      group: 201
      type: 10
      arguments:
        - name: arg1
          dataType: str
        - name: arg2
          dataType: str
        - name: arg3
          dataType: str
        - name: arg4
          dataType: str
        - name: arg5
          dataType: str
        - name: arg6
          dataType: str
        - name: arg7
          dataType: str
        - name: arg8
          dataType: str
        - name: arg9
          dataType: str
        - name: arg10
          dataType: str
        - name: arg11
          dataType: str
        - name: arg12
          dataType: str
    - name: properNoun
      description: "inferred: comes before proper nouns, such as place names and Ganondorf"
      group: 201
      type: 13
    - name: itemNoun
      description: "inferred: comes before an item's name in a sentence, such as Deku seeds, Lon Lon milk or the item a shop is selling. Only English, French and Brazilian Portuguese use it"
      group: 201
      type: 15
